# App
APP_NAME="API Security Engine"
VERSION="1.0.0"
DEBUG=False
API_KEY="generate-a-long-secure-key-here"
JWT_SECRET="generate-a-64-char-secret-here"
JWT_ALGORITHM="HS256"
JWT_EXPIRE_MINUTES=1440
ENCRYPTION_KEY="generate-a-44-plus-char-fernet-key-here"
UNIFIED_PIPELINE_MODE="shadow"

# Database
DATABASE_URL="postgresql+asyncpg://app_user:secure_password_here@localhost:5432/api_security"

# Redis / Kafka (optional)
# REDIS_URL="redis://localhost:6379/0"
# KAFKA_BOOTSTRAP_SERVERS="localhost:9092"
# KAFKA_ENABLED=False

# Security / CORS
CORS_ORIGINS_OVERRIDE="https://app.example.com"
TENANT_RLS_ENABLED=True
INTEGRATIONS_ENFORCE_DESTINATION_GUARD=True
INTEGRATIONS_ALLOW_PRIVATE_DESTINATIONS=False
INTEGRATIONS_RESOLVE_DESTINATION_HOSTS=True
INTEGRATIONS_FAIL_CLOSED_ON_DESTINATION_DNS_ERROR=True

# Active scan safety
PENTEST_REQUIRE_AUTH_PROFILE_FOR_ACTIVE_SCANS=True
PENTEST_ENFORCE_TARGET_GUARD=True
PENTEST_TARGET_ALLOWLIST="api.example.com,*.owned-api.example.com"
PENTEST_ALLOW_PRIVATE_TARGETS=False
PENTEST_RESOLVE_TARGET_HOSTS=True
PENTEST_FAIL_CLOSED_ON_TARGET_DNS_ERROR=True
PENTEST_SCAN_WORK_DIR="./data/pentest-runs"
PENTEST_SCAN_EXECUTION_MODE="queued"
PENTEST_SCAN_WORKER_ISOLATION_MODE="kubernetes_job"
PENTEST_SCAN_WORKER_KUBERNETES_NAMESPACE="api-sentinel"
PENTEST_SCAN_WORKER_KUBERNETES_SERVICE_ACCOUNT="api-sentinel-scan-worker"
PENTEST_SCAN_WORKER_IMAGE="registry.example.com/api-sentinel/scan-worker:latest"
PENTEST_SCAN_WORKER_JOB_TTL_SECONDS=3600
PENTEST_SCAN_WORKER_RESOURCE_CPU="2000m"
PENTEST_SCAN_WORKER_RESOURCE_MEMORY="3Gi"
PENTEST_SCAN_WORKER_RESOURCE_EPHEMERAL_STORAGE="4Gi"
# Optional wall-clock budget (0 = use lease seconds)
# PENTEST_SCAN_WORKER_TIMEOUT_SECONDS=0
PENTEST_KILL_SWITCH_ENABLED=False

# Startup / deploy safety
STARTUP_BOOTSTRAP_SCHEMA=False
STARTUP_ENABLE_DEMO_BOOTSTRAP=False
STARTUP_REFRESH_TEMPLATE_LIBRARY=True
STARTUP_ENSURE_DEFAULT_PLAYBOOKS=False
STARTUP_ENABLE_ANALYTICS_PROCESSOR=False
STARTUP_ENABLE_ARCHIVER=False
STARTUP_ENABLE_TEST_SCHEDULER=True
STARTUP_ENABLE_INGESTION_QUEUE=True
STARTUP_ENABLE_WARM_EXPORTER=True
STARTUP_ENABLE_ENDPOINT_LIFECYCLE=True
STARTUP_ENABLE_RECON_SCHEDULER=True
STARTUP_ENABLE_STREAM_PIPELINE=True

# Tests Library
TESTS_LIBRARY_PATH="./tests-library"

# Optional integrations
# CORAZA_URL="http://localhost:8080"
# DATADOG_API_KEY=""
# STRIPE_SECRET_KEY=""

# Source code scanning
SOURCE_CODE_ENFORCE_REPO_GUARD=True
SOURCE_CODE_ALLOW_PRIVATE_REPOS=False
SOURCE_CODE_RESOLVE_REPO_HOSTS=True
SOURCE_CODE_FAIL_CLOSED_ON_REPO_DNS_ERROR=True
SOURCE_CODE_ALLOW_LOCAL_PATHS=False
SOURCE_CODE_LOCAL_SCAN_ROOT="./source-repos"
